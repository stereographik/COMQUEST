class CfgDebriefing
{
    class CQ_badName
    {
        title = "Name not allowed";
        subtitle = "ComQuest";
        description = "Your player name breaks the server rules. Change it in Arma's main menu (Configure, Profile, Edit) and rejoin.";
    };
    class CQ_kicked
    {
        title = "Removed by an admin";
        subtitle = "ComQuest";
        description = "An admin removed you from the game for breaking the server rules.";
    };
};
