// ComQuest.Altis - mission configuration
// Vanilla Arma 3 only: no CBA, no ACE, no server mod.

author = "Django";
onLoadName = "ComQuest";
onLoadMission = "Destroy the CSAT HQ network on Altis.   v0.13.0  -  main  -  2026-11-13 23:45";   // version line: updated with every deploy
loadScreen = "media\loading.jpg";          // the mission visual, 2048 x 1024 (2:1)
overviewPicture = "media\loading.jpg";     // same picture in the mission list / lobby
overviewText = "Co-op, up to 26 players. A CSAT carrier plants a network of HQs on Altis: find it and cut it apart.";
briefingName = "ComQuest";
briefing = 0;                   // no briefing map screen after the lobby: straight into the game

class Header
{
    gameType = "Coop";
    minPlayers = 1;
    maxPlayers = 26;
};

// --- Respawn: at the airport base -----------------------------------------
joinUnassigned = 0;             // joining players are put on the first free slot (Rifleman first): they only click OK
respawn = 3;                    // BASE (marker "respawn_west", created by script)
respawnDelay = 15;              // keep in sync with CQ_respawnDelay in cfg\settings.sqf
respawnOnStart = -1;            // start on the Eden slot, no respawn at mission start
respawnTemplates[] = {"Revive", "Counter"};

// --- Revive (vanilla BI): medics only, 5 min to be revived, then respawn at the base ---
ReviveMode = 1;                     // enabled for every player
ReviveUnconsciousStateMode = 0;     // basic: a player always goes down instead of dying
ReviveRequiredTrait = 1;            // only medics revive
ReviveRequiredItems = 2;            // Medikit or First Aid Kit
ReviveRequiredItemsFakConsumed = 1;
ReviveDelay = 8;                    // s to revive
ReviveMedicSpeedMultiplier = 1;
ReviveForceRespawnDelay = 1000;     // vanilla "hold to respawn" off: giving up is the BLEEDOUT rule (CQ_fnc_adrenalineSurge)
ReviveBleedOutDelay = 300;          // keep in sync with CQ_bleedOut in cfg\settings.sqf
respawnDialog = 0;
disabledAI = 1;                 // empty slots have no AI

enableDebugConsole = 1;         // host / logged-in admin only

// --- Garbage collector (vanilla) ------------------------------------------
corpseManagerMode = 1;
corpseLimit = 30;
corpseRemovalMinTime = 300;
corpseRemovalMaxTime = 900;
wreckManagerMode = 1;
wreckLimit = 10;
wreckRemovalMinTime = 300;
wreckRemovalMaxTime = 900;
minPlayerDistance = 300;

// --- UI: the mission's button (dark theme, CQ_ui). Hover, focus and press share one colour.
import RscButton;
class CQ_Button: RscButton
{
    font = "PuristaMedium";
    colorBackground[] = {0.2, 0.192, 0.122, 1};
    colorBackgroundActive[] = {0.569, 0.549, 0.231, 1};
    colorFocused[] = {0.569, 0.549, 0.231, 1};
    colorBackgroundDisabled[] = {0.2, 0.192, 0.122, 0.5};
    colorText[] = {0.949, 0.945, 0.875, 1};
    colorDisabled[] = {0.651, 0.639, 0.506, 0.6};
    colorShadow[] = {0, 0, 0, 0};
    colorBorder[] = {0, 0, 0, 0};
    offsetX = 0; offsetY = 0; offsetPressedX = 0; offsetPressedY = 0;
};

// --- On-screen phase messages ---------------------------------------------
class CfgNotifications
{
    class CQ_Phase
    {
        title = "%1";
        description = "%2";
        iconPicture = "\A3\ui_f\data\map\markers\military\warning_ca.paa";
        iconText = "";
        color[] = {0.569, 0.549, 0.231, 1};   // chart olive
        duration = 7;
        priority = 5;
    };
    class CQ_Story
    {
        title = "%1";
        description = "%2";
        iconPicture = "\A3\ui_f\data\igui\cfg\simpleTasks\types\radio_ca.paa";
        iconText = "";
        color[] = {0.651, 0.639, 0.506, 1};   // chart sage
        duration = 9;
        priority = 6;
    };
};

// --- Radio sounds (vanilla files) -----------------------------------------
class CfgSounds
{
    sounds[] = {};
    class CQ_radioIn { name = "CQ_radioIn"; sound[] = {"@A3\Dubbing_Radio_F\sfx\in2a.ogg", 0.6, 1}; titles[] = {}; };
    class CQ_alarm   { name = "CQ_alarm";   sound[] = {"@A3\Sounds_F\sfx\alarm_independent.wss", 1, 1}; titles[] = {}; };
};

